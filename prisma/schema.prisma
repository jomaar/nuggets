generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/**
 * Singleton row (id = "global") holding admin-editable additions to the AI system prompt.
 */
model AppSettings {
  id                   String   @id @default("global")
  globalPromptAddition String?
  updatedAt            DateTime @updatedAt

  @@map("app_settings")
}

model Domain {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  icon         String? // Lucide icon key (e.g. "Cross"), source of truth for app-wide icon rendering
  color        String? // accent colour as hex (e.g. "#2563EB"); falls back to domainColor() palette when null
  domainPrompt String?

  nuggets Nugget[]

  @@map("domains")
}

model Nugget {
  id              String   @id @default(cuid())
  title           String   @default("")
  contentMarkdown String   @default("")
  contentHtml     String
  contentPlain    String
  sourceUrl       String?
  sourceLabel     String?
  aiChatUrl       String?
  tags            String   @default("[]")
  markScheme      String   @default("{}") // per-nugget colour meanings: JSON { "hl:yellow": "These", … } (see lib/marking.ts)
  domainId        String?
  aiInputTokens   Int      @default(0)
  aiOutputTokens  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  domain      Domain?         @relation(fields: [domainId], references: [id])
  reviews     Review[]
  concepts    NuggetConcept[]
  bookmarks   Bookmark[]
  annotations Annotation[]

  @@map("nuggets")
}

/**
 * A reading bookmark: a saved spot inside a nugget the user wants to jump back to.
 * The position is stored as a text-quote anchor (W3C Web Annotation style) rather
 * than a scroll offset or document index, so it survives reflow and edits elsewhere
 * and resolves the right spot even when the quoted text occurs multiple times.
 */
model Bookmark {
  id        String   @id @default(cuid())
  nuggetId  String
  quote     String // exact anchor text (the caret text node), used for matching
  prefix    String // ~30 chars immediately before the quote (disambiguating context)
  suffix    String // ~30 chars immediately after the quote (disambiguating context)
  lineText  String // the surrounding block's text, shown in the bookmark list
  createdAt DateTime @default(now())

  nugget Nugget @relation(fields: [nuggetId], references: [id], onDelete: Cascade)

  @@index([nuggetId])
  @@map("bookmarks")
}

/**
 * A margin comment attached to a spot in a nugget's text. Anchored the same
 * way as bookmarks — a text-quote anchor (W3C Web Annotation style: quote +
 * prefix/suffix context) — NOT stored inline in contentHtml, so the reading
 * text stays untouched and the comment survives reflow and edits elsewhere.
 */
model Annotation {
  id        String   @id @default(cuid())
  nuggetId  String
  quote     String // the commented text span (within one text node), used for matching
  prefix    String // ~30 chars immediately before the quote (disambiguating context)
  suffix    String // ~30 chars immediately after the quote (disambiguating context)
  body      String // the comment text itself
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nugget Nugget @relation(fields: [nuggetId], references: [id], onDelete: Cascade)

  @@index([nuggetId])
  @@map("annotations")
}

model Concept {
  id          String   @id @default(cuid())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labels  ConceptLabel[]
  nuggets NuggetConcept[]

  @@map("concepts")
}

model ConceptLabel {
  id        String @id @default(cuid())
  conceptId String
  language  String // "de" | "en" | "el" | "he"
  term      String

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, language, term])
  @@map("concept_labels")
}

model NuggetConcept {
  nuggetId  String
  conceptId String
  relevance Float   @default(1.0)
  note      String? // what THIS nugget specifically says about the concept (the reading lives on the edge, not the node)

  nugget  Nugget  @relation(fields: [nuggetId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([nuggetId, conceptId])
  @@map("nugget_concepts")
}

model Review {
  id           String   @id @default(cuid())
  nuggetId     String
  nugget       Nugget   @relation(fields: [nuggetId], references: [id], onDelete: Cascade)
  nextReview   DateTime @default(now())
  intervalDays Float    @default(1)
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("reviews")
}
