generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/**
 * Singleton row (id = "global") holding admin-editable additions to the AI system prompt.
 */
model AppSettings {
  id                   String   @id @default("global")
  globalPromptAddition String?
  updatedAt            DateTime @updatedAt

  @@map("app_settings")
}

model Domain {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  icon         String? // Lucide icon key (e.g. "Cross"), source of truth for app-wide icon rendering
  color        String? // accent colour as hex (e.g. "#2563EB"); falls back to domainColor() palette when null
  domainPrompt String?

  nuggets Nugget[]

  @@map("domains")
}

model Nugget {
  id              String   @id @default(cuid())
  title           String   @default("")
  contentMarkdown String   @default("")
  contentHtml     String
  contentPlain    String
  sourceUrl       String?
  sourceLabel     String?
  aiChatUrl       String?
  tags            String   @default("[]")
  markScheme      String   @default("{}") // per-nugget colour meanings: JSON { "hl:yellow": "These", … } (see lib/marking.ts)
  markTemplateId  String? // which MarkTemplate the scheme came from; only labels the popup header + glossary
  domainId        String?
  aiInputTokens   Int      @default(0)
  aiOutputTokens  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  domain       Domain?         @relation(fields: [domainId], references: [id])
  markTemplate MarkTemplate?   @relation(fields: [markTemplateId], references: [id], onDelete: SetNull)
  reviews      Review[]
  concepts     NuggetConcept[]
  bookmarks    Bookmark[]
  annotations  Annotation[]
  shortLinks   ShortLink[]

  @@index([markTemplateId])
  @@map("nuggets")
}

/**
 * A reusable naming scheme for the 12 (style, colour) marking slots.
 *
 * The colour→dimension frame itself is fixed in code (MARK_DIMENSIONS in
 * lib/marking.ts); a template only specializes the LABELS inside that frame for
 * a text genre ("Exegese", "Position", "Bibeltext"). Applying one copies
 * `scheme` into `Nugget.markScheme` — so nothing downstream needs to resolve a
 * template to render marks; the reference is kept only to show the template's
 * name and its long-form glossary in the markings popup.
 *
 * `scheme`/`glossary` are JSON strings keyed by markKey ("hl:yellow"), the same
 * storage pattern as `Nugget.tags` and `Nugget.markScheme`.
 */
model MarkTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  scheme      String // JSON Record<markKey, string> — short labels (≤ 6 chars, swatch width)
  glossary    String   @default("{}") // JSON Record<markKey, string> — long explanations
  builtIn     Boolean  @default(false) // seeded templates: editable but not deletable
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nuggets Nugget[]

  @@map("mark_templates")
}

/**
 * A reading bookmark: a saved spot inside a nugget the user wants to jump back to.
 * The position is stored as a text-quote anchor (W3C Web Annotation style) rather
 * than a scroll offset or document index, so it survives reflow and edits elsewhere
 * and resolves the right spot even when the quoted text occurs multiple times.
 */
model Bookmark {
  id        String   @id @default(cuid())
  nuggetId  String
  quote     String // exact anchor text (the caret text node), used for matching
  prefix    String // ~30 chars immediately before the quote (disambiguating context)
  suffix    String // ~30 chars immediately after the quote (disambiguating context)
  lineText  String // the surrounding block's text, shown in the bookmark list
  createdAt DateTime @default(now())

  nugget Nugget @relation(fields: [nuggetId], references: [id], onDelete: Cascade)

  @@index([nuggetId])
  @@map("bookmarks")
}

/**
 * A margin comment attached to a spot in a nugget's text. Anchored the same
 * way as bookmarks — a text-quote anchor (W3C Web Annotation style: quote +
 * prefix/suffix context) — NOT stored inline in contentHtml, so the reading
 * text stays untouched and the comment survives reflow and edits elsewhere.
 */
model Annotation {
  id        String   @id @default(cuid())
  nuggetId  String
  quote     String // the commented text span (within one text node), used for matching
  prefix    String // ~30 chars immediately before the quote (disambiguating context)
  suffix    String // ~30 chars immediately after the quote (disambiguating context)
  body      String // the comment text itself
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nugget Nugget @relation(fields: [nuggetId], references: [id], onDelete: Cascade)

  @@index([nuggetId])
  @@map("annotations")
}

model Concept {
  id          String   @id @default(cuid())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labels   ConceptLabel[]
  nuggets  NuggetConcept[]
  insights Insight[]

  @@map("concepts")
}

model ConceptLabel {
  id        String @id @default(cuid())
  conceptId String
  language  String // "de" | "en" | "el" | "he"
  term      String

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, language, term])
  @@map("concept_labels")
}

model NuggetConcept {
  nuggetId  String
  conceptId String
  relevance Float   @default(1.0)
  note      String? // what THIS nugget specifically says about the concept (the reading lives on the edge, not the node)

  nugget  Nugget  @relation(fields: [nuggetId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([nuggetId, conceptId])
  @@map("nugget_concepts")
}

/**
 * A generated "Denkanstoß" (insight) — the knowledge graph reasoning ABOUT the
 * user's material, not just visualizing it. Produced by lib/insights.ts from the
 * distilled edge-notes (never full nugget bodies). A NEW persisted entity, not a
 * written-back proximity edge (lib/graph.ts keeps proximity compute-on-read).
 *
 * inputHash = a hash of the exact distilled input that produced this insight.
 * One generation run can yield SEVERAL insights sharing the same (kind, inputHash)
 * — e.g. a concept with multiple internal tensions — so idempotency is enforced in
 * code (lib/insights.ts skips the model call when rows for that (kind, anchorConcept,
 * inputHash) already exist), not by a DB unique constraint. The index below is the
 * cache-lookup path.
 */
model Insight {
  id              String   @id @default(cuid())
  kind            String // "tension" | "question" | "bridge" | "theme"
  status          String   @default("new") // "new" | "kept" | "dismissed"
  title           String // the provocation, one line
  body            String // markdown elaboration / the open question
  anchorConceptId String? // primary concept this hangs off (panel query + cascade); null = cross-cutting
  refs            String   @default("{}") // JSON { conceptIds: string[], nuggetIds: string[] } — jump targets
  inputHash       String // hash of the distilled input → dedupe + staleness detection
  model           String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  createdAt       DateTime @default(now())

  anchorConcept Concept? @relation(fields: [anchorConceptId], references: [id], onDelete: Cascade)

  @@index([kind, inputHash])
  @@index([anchorConceptId])
  @@index([status])
  @@map("insights")
}

/**
 * A short, opaque redirect record for sharing a reading spot OUTSIDE the app
 * (Reminders, Kalender, chat, email) via /s/<code> — see lib/bookmarkLink.ts
 * copyExternalDeepLink. The code carries no information about the content;
 * recognizability for the recipient comes from the label placed next to the
 * link in the plain-text clipboard flavor, not from the URL itself. `path`
 * is unique so re-sharing the same passage dedupes onto the same code.
 */
model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  path      String   @unique
  nuggetId  String
  createdAt DateTime @default(now())

  nugget Nugget @relation(fields: [nuggetId], references: [id], onDelete: Cascade)

  @@index([nuggetId])
  @@map("short_links")
}

model Review {
  id           String   @id @default(cuid())
  nuggetId     String
  nugget       Nugget   @relation(fields: [nuggetId], references: [id], onDelete: Cascade)
  nextReview   DateTime @default(now())
  intervalDays Float    @default(1)
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("reviews")
}
